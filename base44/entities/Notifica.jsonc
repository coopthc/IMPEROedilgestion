{
  "name": "Notifica",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Utente destinatario"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "appuntamento",
        "aggiornamento"
      ],
      "title": "Tipo"
    },
    "titolo": {
      "type": "string",
      "title": "Titolo"
    },
    "testo": {
      "type": "string",
      "title": "Testo"
    },
    "url": {
      "type": "string",
      "title": "URL destinazione"
    },
    "letto": {
      "type": "boolean",
      "default": false,
      "title": "Letto"
    }
  },
  "required": [
    "user_id",
    "tipo",
    "titolo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}