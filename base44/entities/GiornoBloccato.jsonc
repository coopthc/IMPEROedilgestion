{
  "name": "GiornoBloccato",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data bloccata"
    },
    "motivo": {
      "type": "string",
      "title": "Motivo (es. ferie, festivit\u00e0)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "aziendale",
        "personale"
      ],
      "default": "aziendale",
      "title": "Tipo (aziendale o personale)"
    },
    "utente_id": {
      "type": "string",
      "title": "Utente (per blocco personale)"
    },
    "utente_nome": {
      "type": "string",
      "title": "Nome utente"
    }
  },
  "required": [
    "data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "data.tipo": "aziendale"
        },
        {
          "$and": [
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_capo"
              }
            },
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_operaio"
              }
            },
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "$and": [
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "$and": [
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}