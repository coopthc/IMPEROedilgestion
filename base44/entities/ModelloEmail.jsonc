{
  "name": "ModelloEmail",
  "type": "object",
  "properties": {
    "chiave": {
      "type": "string",
      "title": "Chiave univoca"
    },
    "nome": {
      "type": "string",
      "title": "Nome visualizzato"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "cliente",
        "collaboratore",
        "sistema"
      ],
      "title": "Categoria"
    },
    "oggetto": {
      "type": "string",
      "title": "Oggetto email"
    },
    "corpo": {
      "type": "string",
      "title": "Corpo email"
    },
    "variabili": {
      "type": "string",
      "title": "Variabili disponibili"
    }
  },
  "required": [
    "chiave",
    "nome",
    "categoria"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}