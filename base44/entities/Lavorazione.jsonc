{
  "name": "Lavorazione",
  "type": "object",
  "properties": {
    "cantiere_id": {
      "type": "string",
      "title": "Cantiere"
    },
    "cantiere_nome": {
      "type": "string",
      "title": "Nome cantiere"
    },
    "titolo": {
      "type": "string",
      "title": "Titolo"
    },
    "descrizione": {
      "type": "string",
      "title": "Descrizione"
    },
    "stato": {
      "type": "string",
      "enum": [
        "da_fare",
        "in_corso",
        "completata",
        "bloccata",
        "annullata"
      ],
      "default": "da_fare",
      "title": "Stato"
    },
    "collaboratori_ids": {
      "type": "string",
      "title": "ID collaboratori (separati da virgola)"
    },
    "collaboratori_nomi": {
      "type": "string",
      "title": "Nomi collaboratori (separati da virgola)"
    },
    "percentuale_prevista": {
      "type": "number",
      "default": 0,
      "title": "Percentuale prevista (pronostico)"
    },
    "percentuale_completata": {
      "type": "number",
      "default": 0,
      "title": "Percentuale completata (effettivo)"
    },
    "costo": {
      "type": "number",
      "default": 0,
      "title": "Costo lavorazione (\u20ac)"
    },
    "aggiunta_al_budget": {
      "type": "boolean",
      "default": false,
      "title": "Aggiunta al budget"
    },
    "visibile_cliente": {
      "type": "boolean",
      "default": false,
      "title": "Visibile al cliente"
    },
    "ore_previste": {
      "type": "number",
      "title": "Ore previste"
    },
    "ordine": {
      "type": "number",
      "default": 0,
      "title": "Ordine"
    }
  },
  "required": [
    "cantiere_id",
    "titolo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "mssg_capo"
                  }
                },
                {
                  "user_condition": {
                    "role": "mssg_operaio"
                  }
                }
              ]
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_cliente"
              }
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}