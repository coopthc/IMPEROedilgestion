{
  "name": "Appuntamento",
  "type": "object",
  "properties": {
    "titolo": {
      "type": "string",
      "title": "Titolo"
    },
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "ora": {
      "type": "string",
      "title": "Ora"
    },
    "durata_minuti": {
      "type": "number",
      "default": 60,
      "title": "Durata (minuti)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "lavorativo",
        "personale"
      ],
      "default": "lavorativo",
      "title": "Categoria"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "interno",
        "richiesta",
        "confermato",
        "admin_fissato"
      ],
      "default": "interno",
      "title": "Tipo"
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "cliente_nome": {
      "type": "string",
      "title": "Nome cliente"
    },
    "cantiere_id": {
      "type": "string",
      "title": "Cantiere"
    },
    "cantiere_nome": {
      "type": "string",
      "title": "Nome cantiere"
    },
    "partecipanti_ids": {
      "type": "string",
      "title": "ID partecipanti (separati da virgola)"
    },
    "partecipanti_nomi": {
      "type": "string",
      "title": "Nomi partecipanti (separati da virgola)"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "stato": {
      "type": "string",
      "enum": [
        "in_attesa",
        "programmato",
        "proposto",
        "completato",
        "annullato"
      ],
      "default": "programmato",
      "title": "Stato"
    },
    "motivo": {
      "type": "string",
      "title": "Motivo rifiuto / nota proposta"
    },
    "richiedente_tipo": {
      "type": "string",
      "enum": [
        "cliente",
        "collaboratore"
      ],
      "title": "Tipo richiedente"
    },
    "richiedente_nome": {
      "type": "string",
      "title": "Nome richiedente"
    }
  },
  "required": [
    "titolo",
    "data",
    "ora"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "user_condition": {
            "role": "mssg_operaio"
          }
        },
        {
          "data.cliente_id": "{{user.data.cliente_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "user_condition": {
            "role": "mssg_operaio"
          }
        },
        {
          "user_condition": {
            "role": "mssg_cliente"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    }
  }
}