{
  "name": "Appuntamento",
  "type": "object",
  "properties": {
    "titolo": {
      "type": "string",
      "title": "Titolo"
    },
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "ora": {
      "type": "string",
      "title": "Ora"
    },
    "durata_minuti": {
      "type": "number",
      "default": 60,
      "title": "Durata (minuti)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "lavorativo",
        "personale"
      ],
      "default": "lavorativo",
      "title": "Categoria"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "interno",
        "richiesta",
        "confermato",
        "admin_fissato"
      ],
      "default": "interno",
      "title": "Tipo"
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "cliente_nome": {
      "type": "string",
      "title": "Nome cliente"
    },
    "cantiere_id": {
      "type": "string",
      "title": "Cantiere"
    },
    "cantiere_nome": {
      "type": "string",
      "title": "Nome cantiere"
    },
    "partecipanti_ids": {
      "type": "string",
      "title": "ID partecipanti (separati da virgola)"
    },
    "partecipanti_nomi": {
      "type": "string",
      "title": "Nomi partecipanti (separati da virgola)"
    },
    "utenti_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "ID utenti partecipanti (per accesso RLS)"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "stato": {
      "type": "string",
      "enum": [
        "in_attesa",
        "programmato",
        "proposto",
        "completato",
        "annullato"
      ],
      "default": "programmato",
      "title": "Stato"
    },
    "motivo": {
      "type": "string",
      "title": "Motivo rifiuto / nota proposta"
    },
    "richiedente_tipo": {
      "type": "string",
      "enum": [
        "cliente",
        "collaboratore"
      ],
      "title": "Tipo richiedente"
    },
    "richiedente_nome": {
      "type": "string",
      "title": "Nome richiedente"
    },
    "richiedi_conferma": {
      "type": "boolean",
      "default": false,
      "title": "Richiedi conferma presenza"
    },
    "risposte_json": {
      "type": "string",
      "title": "Risposte partecipanti (JSON user_id -> {risposta, nome, data})"
    }
  },
  "required": [
    "titolo",
    "data",
    "ora"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.categoria": "personale"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.categoria": {
                "$ne": "personale"
              }
            },
            {
              "$or": [
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "$or": [
                        {
                          "data.cantiere_id": {
                            "$ne": ""
                          }
                        },
                        {
                          "created_by_id": "{{user.id}}"
                        },
                        {
                          "data.utenti_ids": "{{user.id}}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "mssg_admin"
                      }
                    },
                    {
                      "user_condition": {
                        "data.supervisore_tutti_cantieri": true
                      }
                    },
                    {
                      "$or": [
                        {
                          "data.cantiere_id": {
                            "$ne": ""
                          }
                        },
                        {
                          "created_by_id": "{{user.id}}"
                        },
                        {
                          "data.utenti_ids": "{{user.id}}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "mssg_admin"
                      }
                    },
                    {
                      "$or": [
                        {
                          "data.cantiere_id": {
                            "$in": "{{user.data.cantieri_ids}}"
                          }
                        },
                        {
                          "created_by_id": "{{user.id}}"
                        },
                        {
                          "data.utenti_ids": "{{user.id}}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "$or": [
                        {
                          "user_condition": {
                            "role": "mssg_capo"
                          }
                        },
                        {
                          "user_condition": {
                            "role": "mssg_operaio"
                          }
                        }
                      ]
                    },
                    {
                      "data.utenti_ids": "{{user.id}}"
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "mssg_cliente"
                      }
                    },
                    {
                      "$or": [
                        {
                          "data.cliente_id": "{{user.data.cliente_id}}"
                        },
                        {
                          "data.utenti_ids": "{{user.id}}"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "user_condition": {
            "role": "mssg_operaio"
          }
        },
        {
          "user_condition": {
            "role": "mssg_cliente"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.categoria": "personale"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.categoria": {
                "$ne": "personale"
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "role": "mssg_capo"
                      }
                    },
                    {
                      "data.utenti_ids": {
                        "$in": [
                          "{{user.id}}"
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.categoria": "personale"
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.categoria": {
                "$ne": "personale"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}