{
  "name": "Cantiere",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome cantiere"
    },
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "cliente_nome": {
      "type": "string",
      "title": "Nome cliente"
    },
    "responsabile_id": {
      "type": "string",
      "title": "Responsabile / Capo cantiere"
    },
    "responsabile_nome": {
      "type": "string",
      "title": "Nome responsabile"
    },
    "indirizzo": {
      "type": "string",
      "title": "Indirizzo"
    },
    "citta": {
      "type": "string",
      "title": "Citt\u00e0"
    },
    "stato": {
      "type": "string",
      "enum": [
        "bozza",
        "attivo",
        "sospeso",
        "completato",
        "chiuso"
      ],
      "default": "attivo",
      "title": "Stato"
    },
    "data_inizio": {
      "type": "string",
      "format": "date",
      "title": "Data inizio"
    },
    "data_fine": {
      "type": "string",
      "format": "date",
      "title": "Data fine"
    },
    "budget": {
      "type": "number",
      "title": "Budget"
    },
    "descrizione": {
      "type": "string",
      "title": "Descrizione"
    },
    "foto_url": {
      "type": "string",
      "format": "uri",
      "title": "Foto cantiere"
    },
    "collaboratori_ids": {
      "type": "string",
      "title": "ID collaboratori (separati da virgola)"
    },
    "collaboratori_ruoli": {
      "type": "string",
      "title": "Ruoli collaboratori (JSON id->ruolo)"
    },
    "modalita_avanzamento": {
      "type": "string",
      "enum": [
        "manuale",
        "pronostico"
      ],
      "default": "manuale",
      "title": "Modalit\u00e0 avanzamento"
    },
    "avanzamento_percentuale": {
      "type": "number",
      "default": 0,
      "title": "Avanzamento %"
    },
    "note_interne": {
      "type": "string",
      "title": "Note interne (mai visibili al cliente)"
    },
    "archiviato": {
      "type": "boolean",
      "default": false,
      "title": "Archiviato"
    }
  },
  "required": [
    "nome"
  ]
}