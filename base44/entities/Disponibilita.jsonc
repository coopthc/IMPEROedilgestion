{
  "name": "Disponibilita",
  "type": "object",
  "properties": {
    "giorno_settimana": {
      "type": "number",
      "minimum": 0,
      "maximum": 6,
      "title": "Giorno settimana (0=dom)"
    },
    "ora_inizio": {
      "type": "string",
      "title": "Ora inizio"
    },
    "ora_fine": {
      "type": "string",
      "title": "Ora fine"
    },
    "durata_slot": {
      "type": "number",
      "default": 60,
      "title": "Durata slot (minuti)"
    },
    "attivo": {
      "type": "boolean",
      "default": true,
      "title": "Attivo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "aziendale",
        "personale"
      ],
      "default": "aziendale",
      "title": "Tipo (aziendale o personale)"
    },
    "utente_id": {
      "type": "string",
      "title": "Utente (per disponibilita personale)"
    },
    "utente_nome": {
      "type": "string",
      "title": "Nome utente"
    }
  },
  "required": [
    "giorno_settimana",
    "ora_inizio",
    "ora_fine"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "data.tipo": "aziendale"
        },
        {
          "$and": [
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_capo"
              }
            },
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_operaio"
              }
            },
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "$and": [
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "$and": [
            {
              "data.tipo": "personale"
            },
            {
              "data.utente_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}