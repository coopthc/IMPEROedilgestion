{
  "name": "Pagamento",
  "type": "object",
  "properties": {
    "cantiere_id": {
      "type": "string",
      "title": "Cantiere"
    },
    "cantiere_nome": {
      "type": "string",
      "title": "Nome cantiere"
    },
    "titolo": {
      "type": "string",
      "title": "Titolo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "acconto",
        "avanzamento",
        "saldo"
      ],
      "default": "acconto",
      "title": "Tipo"
    },
    "percentuale": {
      "type": "number",
      "title": "Percentuale"
    },
    "importo": {
      "type": "number",
      "title": "Importo"
    },
    "data_scadenza": {
      "type": "string",
      "format": "date",
      "title": "Data scadenza"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "title": "Data pagamento"
    },
    "stato": {
      "type": "string",
      "enum": [
        "non_pagato",
        "pagato",
        "parziale"
      ],
      "default": "non_pagato",
      "title": "Stato"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "lavorazione_id": {
      "type": "string",
      "title": "Lavorazione collegata"
    },
    "notifica_inviata_data": {
      "type": "string",
      "format": "date",
      "title": "Data invio notifica al cliente"
    },
    "notifica_inviata_a": {
      "type": "string",
      "title": "Email destinatario notifica"
    }
  },
  "required": [
    "cantiere_id",
    "titolo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_admin"
              }
            },
            {
              "user_condition": {
                "data.supervisore_pagamenti": true
              }
            },
            {
              "user_condition": {
                "data.supervisore_tutti_cantieri": true
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_admin"
              }
            },
            {
              "user_condition": {
                "data.supervisore_pagamenti": true
              }
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_cliente"
              }
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_admin"
              }
            },
            {
              "user_condition": {
                "data.supervisore_pagamenti": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_admin"
              }
            },
            {
              "user_condition": {
                "data.supervisore_pagamenti": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}