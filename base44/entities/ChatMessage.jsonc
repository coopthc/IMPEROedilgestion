{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "canale": {
      "type": "string",
      "enum": [
        "cliente",
        "squadra"
      ],
      "title": "Canale"
    },
    "cantiere_id": {
      "type": "string",
      "title": "Cantiere"
    },
    "mittente_id": {
      "type": "string",
      "title": "Mittente"
    },
    "mittente_nome": {
      "type": "string",
      "title": "Nome mittente"
    },
    "mittente_ruolo": {
      "type": "string",
      "title": "Ruolo mittente"
    },
    "testo": {
      "type": "string",
      "title": "Testo"
    },
    "letto_da": {
      "type": "string",
      "title": "ID utenti che hanno letto"
    }
  },
  "required": [
    "canale",
    "mittente_id",
    "testo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "user_condition": {
            "role": "mssg_operaio"
          }
        },
        {
          "$and": [
            {
              "data.canale": "cliente"
            },
            {
              "data.cliente_id": "{{user.data.cliente_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "user_condition": {
            "role": "mssg_operaio"
          }
        },
        {
          "user_condition": {
            "role": "mssg_cliente"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}