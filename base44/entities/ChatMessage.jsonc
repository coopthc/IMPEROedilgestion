{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "canale": {
      "type": "string",
      "enum": [
        "cliente",
        "squadra"
      ],
      "title": "Canale"
    },
    "cantiere_id": {
      "type": "string",
      "title": "Cantiere"
    },
    "mittente_id": {
      "type": "string",
      "title": "Mittente"
    },
    "mittente_nome": {
      "type": "string",
      "title": "Nome mittente"
    },
    "mittente_ruolo": {
      "type": "string",
      "title": "Ruolo mittente"
    },
    "testo": {
      "type": "string",
      "title": "Testo"
    },
    "letto_da": {
      "type": "string",
      "title": "ID utenti che hanno letto"
    }
  },
  "required": [
    "canale",
    "mittente_id",
    "testo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_admin"
              }
            },
            {
              "user_condition": {
                "data.supervisore_tutti_cantieri": true
              }
            },
            {
              "$or": [
                {
                  "data.canale": "squadra"
                },
                {
                  "user_condition": {
                    "data.supervisore_chat": true
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_admin"
              }
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            },
            {
              "$or": [
                {
                  "data.canale": "squadra"
                },
                {
                  "user_condition": {
                    "data.supervisore_chat": true
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "mssg_capo"
                  }
                },
                {
                  "user_condition": {
                    "role": "mssg_operaio"
                  }
                }
              ]
            },
            {
              "data.canale": "squadra"
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_cliente"
              }
            },
            {
              "data.canale": "cliente"
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "user_condition": {
            "role": "mssg_operaio"
          }
        },
        {
          "user_condition": {
            "role": "mssg_cliente"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}