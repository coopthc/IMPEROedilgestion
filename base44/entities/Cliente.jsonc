{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome / Referente"
    },
    "is_azienda": {
      "type": "boolean",
      "default": false,
      "title": "\u00c8 un'azienda"
    },
    "azienda": {
      "type": "string",
      "title": "Ragione sociale"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "telefono": {
      "type": "string",
      "title": "Telefono"
    },
    "indirizzo": {
      "type": "string",
      "title": "Indirizzo"
    },
    "citta": {
      "type": "string",
      "title": "Citt\u00e0"
    },
    "cap": {
      "type": "string",
      "title": "CAP"
    },
    "provincia": {
      "type": "string",
      "title": "Provincia"
    },
    "piva": {
      "type": "string",
      "title": "Partita IVA"
    },
    "codice_fiscale": {
      "type": "string",
      "title": "Codice fiscale"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "user_id": {
      "type": "string",
      "title": "Utente collegato"
    },
    "logo_url": {
      "type": "string",
      "format": "uri",
      "title": "Logo / Foto profilo"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "id": "{{user.data.cliente_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "id": "{{user.data.cliente_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}