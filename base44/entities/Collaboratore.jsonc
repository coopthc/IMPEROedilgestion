{
  "name": "Collaboratore",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome"
    },
    "is_azienda": {
      "type": "boolean",
      "default": false,
      "title": "\u00c8 un'azienda"
    },
    "azienda": {
      "type": "string",
      "title": "Ragione sociale"
    },
    "qualifica": {
      "type": "string",
      "enum": [
        "capo_cantiere",
        "operaio",
        "tecnico",
        "amministrazione",
        "altro"
      ],
      "default": "operaio",
      "title": "Qualifica"
    },
    "costo_orario": {
      "type": "number",
      "title": "Costo orario"
    },
    "telefono": {
      "type": "string",
      "title": "Telefono"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "indirizzo": {
      "type": "string",
      "title": "Indirizzo"
    },
    "citta": {
      "type": "string",
      "title": "Citt\u00e0"
    },
    "cap": {
      "type": "string",
      "title": "CAP"
    },
    "provincia": {
      "type": "string",
      "title": "Provincia"
    },
    "piva": {
      "type": "string",
      "title": "Partita IVA"
    },
    "codice_fiscale": {
      "type": "string",
      "title": "Codice fiscale"
    },
    "attivo": {
      "type": "boolean",
      "default": true,
      "title": "Attivo"
    },
    "user_id": {
      "type": "string",
      "title": "Utente collegato"
    }
  },
  "required": [
    "nome"
  ]
}