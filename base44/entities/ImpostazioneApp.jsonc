{
  "name": "ImpostazioneApp",
  "type": "object",
  "properties": {
    "ragione_sociale": {
      "type": "string",
      "title": "Ragione sociale"
    },
    "logo_url": {
      "type": "string",
      "format": "uri",
      "title": "Logo azienda"
    },
    "piva": {
      "type": "string",
      "title": "Partita IVA"
    },
    "codice_fiscale": {
      "type": "string",
      "title": "Codice fiscale"
    },
    "indirizzo": {
      "type": "string",
      "title": "Indirizzo"
    },
    "citta": {
      "type": "string",
      "title": "Citt\u00e0"
    },
    "cap": {
      "type": "string",
      "title": "CAP"
    },
    "provincia": {
      "type": "string",
      "title": "Provincia"
    },
    "telefono": {
      "type": "string",
      "title": "Telefono"
    },
    "email_azienda": {
      "type": "string",
      "format": "email",
      "title": "Email azienda"
    },
    "appuntamenti_contemporanei": {
      "type": "number",
      "default": 1,
      "minimum": 1,
      "title": "Appuntamenti contemporanei (capacit\u00e0)"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}