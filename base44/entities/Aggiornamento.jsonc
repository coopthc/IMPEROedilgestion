{
  "name": "Aggiornamento",
  "type": "object",
  "properties": {
    "cantiere_id": {
      "type": "string",
      "title": "Cantiere"
    },
    "cantiere_nome": {
      "type": "string",
      "title": "Nome cantiere"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "aggiornamento",
        "avviso",
        "completamento",
        "problema"
      ],
      "default": "aggiornamento",
      "title": "Tipo"
    },
    "titolo": {
      "type": "string",
      "title": "Titolo"
    },
    "testo": {
      "type": "string",
      "title": "Testo"
    },
    "visibile_cliente": {
      "type": "boolean",
      "default": false,
      "title": "Visibile al cliente"
    },
    "autore_nome": {
      "type": "string",
      "title": "Autore"
    }
  },
  "required": [
    "cantiere_id",
    "titolo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "mssg_capo"
                  }
                },
                {
                  "user_condition": {
                    "role": "mssg_operaio"
                  }
                }
              ]
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "mssg_cliente"
              }
            },
            {
              "data.visibile_cliente": true
            },
            {
              "data.cantiere_id": {
                "$in": "{{user.data.cantieri_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        },
        {
          "user_condition": {
            "role": "mssg_operaio"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_capo"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mssg_admin"
          }
        }
      ]
    }
  }
}